# ---------------------------------------------------------------------------
# Orçamento Fácil — API. Copie para .env e ajuste. Variáveis sem valor padrão
# (DATABASE_URL, JWT_SECRET, DATA_ENCRYPTION_KEY) são obrigatórias.
# ---------------------------------------------------------------------------

# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# URL pública da API (usada no link de recuperação de senha)
PUBLIC_BASE_URL=http://localhost:3000
# Origens permitidas (CORS), separadas por vírgula; "*" libera todas
CORS_ORIGIN=*
# true quando a API está atrás do Nginx/proxy (IP real do cliente)
TRUST_PROXY=false

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myapi
DATABASE_POOL_MAX=10

# Autenticação (R03, R87)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_RATE_LIMIT_MAX=20
# Custo do hash de senha (scrypt): N = 2^SCRYPT_COST_LOG2
SCRYPT_COST_LOG2=15
SCRYPT_PARALLELIZATION=3
# E-mails que recebem perfil de administrador (modo de manutenção, logs)
ADMIN_EMAILS=
# Login por biometria (R40): validade do desafio assinado pelo aparelho, em segundos
BIOMETRIC_CHALLENGE_TTL_SECONDS=120

# Recuperação de senha (R04)
PASSWORD_RESET_TTL_MINUTES=60
# Padrão: ${PUBLIC_BASE_URL}/reset-password (página servida pela própria API)
# PASSWORD_RESET_URL=https://app.exemplo.com/reset-password

# Criptografia dos dados financeiros (R81) — 32 bytes em base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA troque a chave sem manter a anterior em DATA_ENCRYPTION_PREVIOUS_KEYS.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_VERSION=1
# Chaves antigas para leitura após rotação: "1:<base64>,2:<base64>"
DATA_ENCRYPTION_PREVIOUS_KEYS=

# E-mail (sem SMTP_HOST, em desenvolvimento os e-mails aparecem no log)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=seu@gmail.com,
#        SMTP_PASSWORD=<senha de app de 16 caracteres> (conta com verificação em 2 etapas),
#        MAIL_FROM="Orçamento Fácil <seu@gmail.com>" (o Gmail reescreve o remetente para a conta).
# Porta 465 usa SMTP_SECURE=true. Teste com: npm run mail:test -- destino@exemplo.com
# Provisório (só em desenvolvimento): true envia para uma conta de teste Ethereal e o log
# mostra o link para ver o e-mail. Ignorado se SMTP_HOST estiver definido.
SMTP_ETHEREAL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Orçamento Fácil <no-reply@orcamentofacil.app>"

# Câmbio (R29) — ExchangeRate-API, acesso aberto e gratuito
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
EXCHANGE_RATE_CACHE_MINUTES=360
EXCHANGE_RATE_TIMEOUT_MS=5000

# Desfazer (R49) e manutenção (R72)
UNDO_WINDOW_HOURS=24
# true força o modo de manutenção (ex.: durante o deploy)
MAINTENANCE_MODE=false

# Limpeza periódica de dados vencidos (sessões, links de recuperação, histórico e logs antigos)
# 0 desliga a execução automática (POST /api/admin/housekeeping continua disponível)
HOUSEKEEPING_INTERVAL_MINUTES=60
# Histórico de ações (nunca menos que a janela do desfazer)
HISTORY_RETENTION_DAYS=30
# Eventos em app_logs (R85)
LOG_RETENTION_DAYS=90

# Tarefas agendadas: ocorrências de recorrências e parcelas, lembretes e reenvio de push
# 0 desliga a execução automática (POST /api/admin/jobs/run continua disponível)
JOBS_INTERVAL_MINUTES=15

# Push pelo Firebase Cloud Messaging (R18). Use o JSON da conta de serviço (fora do git)
# ou as três variáveis. Sem nada disso, o push é apenas registrado no log.
# FCM_SERVICE_ACCOUNT_FILE=/caminho/fora/do/projeto/firebase-conta-de-servico.json
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Testes de integração (banco isolado do docker-compose.test.yml)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/orcamento_test
